#!/bin/sh
# Local stand-in for a required status check: server-side branch protection is plan-gated on private
# free-plan repositories, and every push to this repository originates from this machine — so the gate
# runs here, before the network. Install (once per clone):
#   ln -s ../../scripts/pre-push .git/hooks/pre-push
# It checks the WORKING TREE state of tracked files — deliberately, and with a known asymmetry:
#   - an uncommitted violation in a tracked file blocks the push (earlier than any server check);
#   - the converse hole: if the tree is green but the commits being pushed are red (a fix made but not
#     committed), this hook passes and CI goes red after landing — CI stays the authoritative record;
#   - a brand-new file escapes until `git add` makes it tracked.
node "$(git rev-parse --show-toplevel)/scripts/check-skill-policy.mjs" || {
  echo "push blocked: the skill-policy gate is red (see above)" >&2
  exit 1
}
