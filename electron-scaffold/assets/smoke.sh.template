#!/bin/bash
# Dev smoke template: start → wait for the ready artifact → catch main-process errors → kill the parent to verify orphan protection.
# The canonical copy lives in the electron-scaffold skill; after copying it to the project as scripts/smoke.sh, fill in the
# "project fill-ins" block below. Design rationale and verification: section 3 of electron-scaffold's electron-testing.md
# — **after installing, force every failure branch once**; a gate never shown to turn red is no gate.
#
# **Coexisting with an instance that is already open** (measured on agentshed):
#   - userData isolation: the dev app starts via `pnpm dev -- --user-data-dir=<temp dir>` (measured:
#     electron-vite passes the argument through and Electron honours it — the same mechanism as e2e; zero pollution
#     of the real archive verified).
#     The single-instance lock is scoped by userData, so once isolated it does not contend with the app the user has open
#     — before this, when the lock was taken, the app started here exited via app.exit(0) and looked dead: the root cause of three false reds.
#   - Process-group isolation: set -m puts background jobs in their own process group, and every probe and kill only
#     touches our own tree (pgrep/kill by pgid), never the user's instance.
#   - The business data the app reads is unaffected (that is HOME's / the data root's business, unrelated to userData); a
#     fresh userData every time = a deterministic first-launch path every time — a gate wants determinism, not a fast run on leftover state.
#     The "old data migration" scenario belongs to e2e (seeded fixtures); the smoke run is not expected to hit it.
#
# Always poll until the condition holds; never a fixed sleep:
#   a false red costs more than slowness: once a gate flakes a few times, "just rerun it" becomes a habit and it stops being a gate.
# Timeouts leave ample headroom over the measured magnitude, and the actual times are printed — a slowdown stays visible instead of creeping toward the timeout.
set -u
set -m   # background jobs get their own process group: $! is the pgid, the boundary for probing and killing
cd "$(dirname "$0")/.."

# ══════════════ Project fill-ins (copy the rest as is) ══════════════
APP=myapp                                    # project short name: used for log and temp-dir names
QUIET_ENV=MYAPP_NO_FOREGROUND                # env name of the main process's quiet test seam (section 1 of electron-scaffold's electron-testing.md)
# ① Ready artifact: a file the app **atomically writes** on every start, as a path relative to userData.
#    Criterion: its appearance = the main process completed one full pass of the core path; if no such file exists, add one to the app first.
READY_ARTIFACT="your-ready-artifact.json"        # e.g. agentshed uses token-cache.json
# ② Process match for this project's dev Electron (include the repository path so another Electron project does not match; read as ERE, so escape metacharacters such as + and . in the path)
PAT="path/to/your-repo/node_modules.*Electron.app/Contents/MacOS/Electron"
PACKAGED_PAT="MyApp.app/Contents/MacOS/MyApp" # packaged binary (only for the coexistence notice)
# ③ Real userData (only a read-only control for the "redirection failed" self-diagnosis; this script never writes it)
REAL_UD="$HOME/Library/Application Support/myapp"
# Main-process error signatures; append the project's own fatal markers (such as contract-validation failures)
ERR_PATTERN="Error occurred in handler|UnhandledPromiseRejection|TypeError|uncaught"
# ════════════════════════════════════════════════════════════════════

# Unfilled guard: placeholder values fail at once, instead of leaving someone to guess at a 60 s timeout
case "$PAT$READY_ARTIFACT" in
  *your-repo* | *your-ready-artifact*)
    echo "SMOKE_FAIL: template not filled in — fill in the \"project fill-ins\" block at the top first (PAT / READY_ARTIFACT are still placeholders)"; exit 1 ;;
esac

LOG=/tmp/$APP-smoke.log
SMOKE_UD=$(mktemp -d "/tmp/$APP-smoke-ud.XXXXXX")
CACHE="$SMOKE_UD/$READY_ARTIFACT"
REAL_CACHE="$REAL_UD/$READY_ARTIFACT"

# Timeout rule: measure the magnitude once, allow ten times that, and print the actual time on success —
# a slowdown stays visible instead of creeping toward the timeout. Lesson learned (agentshed): three false reds on timeout,
# and the real cause was not slowness but **death** (a silent exit because the lock was taken); with both isolations, a timeout is a real timeout.
START_TIMEOUT=60   # [tune to measured] electron process appears; agentshed measured ~1.1 s
READY_TIMEOUT=60   # [tune to measured] ready artifact appears; agentshed's full first scan measured ~6 s
EXIT_TIMEOUT=15    # [tune to measured] self-exit after the parent is killed: the main process polls the parent every 1 s, plus exit overhead

now_ms() { echo $(( $(date +%s%N) / 1000000 )); }
DEVPID=""
alive() { [ -n "$DEVPID" ] && pgrep -g "$DEVPID" -f "$PAT" >/dev/null 2>&1; }
cleanup() {
  [ -n "$DEVPID" ] && kill -9 -- "-$DEVPID" 2>/dev/null
  rm -rf "$SMOKE_UD"
}
die() {
  echo "SMOKE_FAIL: $1"
  # The scene must be kept: do not bet on the caller not grepping — agentshed's three misdiagnoses all came from filtered failure output and no evidence left
  KEEP="/tmp/$APP-smoke-fail-$(date +%Y%m%d-%H%M%S).log"
  cp "$LOG" "$KEEP" 2>/dev/null && echo "full log saved: $KEEP"
  tail -25 "$LOG"
  cleanup
  exit 1
}

# An existing instance is only reported, never blocked — coexistence after isolation is a feature. Filter by comm, because pgrep -f
# reports false matches from path strings in other processes' argv (such as a pkill command line); a path match is not the process itself.
# Keep every case statement outside command substitution (lifted into a function here): bash 3.2 cannot parse a case nested
# inside $( ), and macOS's /bin/bash is exactly 3.2, so the whole script fails at the syntax stage. Syntax checks must use
# `/bin/bash -n` — the bash on PATH is usually 5.x, which parses it and so gives the opposite answer.
is_our_electron() {
  case "$(ps -o comm= -p "$1" 2>/dev/null)" in
    *Electron | *"${PACKAGED_PAT##*/}") return 0 ;;
  esac
  return 1
}
OTHERS=$(pgrep -f "$PAT|$PACKAGED_PAT" 2>/dev/null | while read -r p; do
  is_our_electron "$p" && echo "$p"
done | tr '\n' ' ')
[ -n "$OTHERS" ] && echo "(existing instance detected, pid=$OTHERS — userData is isolated, so they do not affect each other and none will be killed by mistake)"

REAL_BEFORE=$(stat -f %m "$REAL_CACHE" 2>/dev/null || echo 0)

# The two quiet-test pieces (sections 1/2 of electron-scaffold's electron-testing.md + scripts/quiet-electron.sh):
#   $QUIET_ENV — the window is not shown and does not take foreground focus;
#   ELECTRON_OVERRIDE_DIST_PATH — use the copy with LSUIElement=true, so the Dock icon does not even flash
#   (the icon is registered from the plist during native bootstrap; JS's dock.hide() cannot catch up).
bash scripts/quiet-electron.sh
export ELECTRON_OVERRIDE_DIST_PATH="$PWD/node_modules/.cache/electron-quiet/dist"
# electron-vite does **not** go through electron/index.js (it reads path.txt and builds the path itself; measured in the lib source),
# so the variable above has no effect on it; it honours its own ELECTRON_EXEC_PATH, so set both
export ELECTRON_EXEC_PATH="$PWD/node_modules/.cache/electron-quiet/dist/Electron.app/Contents/MacOS/Electron"
env "$QUIET_ENV=1" pnpm dev -- --user-data-dir="$SMOKE_UD" > "$LOG" 2>&1 &
DEVPID=$!
T0=$(now_ms)
until alive; do
  (( $(now_ms) - T0 > START_TIMEOUT * 1000 )) && die "electron did not start within ${START_TIMEOUT}s (in this group)"
  sleep 0.2
done
UP_MS=$(( $(now_ms) - T0 ))

# Readiness means "the core path ran": after starting, the app always atomically writes the ready artifact (in the isolated
# directory, which a first launch in a fresh directory always writes); the file appearing proves the core path ran, and a silent failure times out red.
T1=$(now_ms)
until [ "$(stat -f %m "$CACHE" 2>/dev/null || echo 0)" -gt 0 ]; do
  if ! alive; then
    die "electron exited after starting (main process crashed? see the log below)"
  fi
  if (( $(now_ms) - T1 > READY_TIMEOUT * 1000 )); then
    # Discriminating diagnosis: the isolated side did not change but the real userData did = the --user-data-dir pass-through broke
    # (electron-vite dropping it after an upgrade, say), and the app went off to write the real userData
    REAL_NOW=$(stat -f %m "$REAL_CACHE" 2>/dev/null || echo 0)
    if [ "$REAL_NOW" -gt "$REAL_BEFORE" ]; then
      die "userData redirection failed: the isolated side was not updated but the real userData was — check that pnpm dev passes --user-data-dir through"
    fi
    die "ready artifact did not appear within ${READY_TIMEOUT}s ($READY_ARTIFACT)"
  fi
  sleep 0.3
done
READY_MS=$(( $(now_ms) - T1 ))

ERRS=$(grep -iE "$ERR_PATTERN" "$LOG" | head -5)

EPID=$(pgrep -g "$DEVPID" -f "$PAT" | head -1)
# Race guard: the app may crash right after writing the ready artifact — if EPID is empty, the whole kill-parent and orphan check
# runs on nothing, and with no error lines in the log that is a false green. After readiness the process must still be alive; if not, fail.
[ -z "$EPID" ] && die "the ready artifact was written, but the electron process is gone (crashed right after writing?)"
PARENT=$(ps -o ppid= -p "$EPID" | tr -d ' ')
T2=$(now_ms)
kill -9 "$PARENT" 2>/dev/null
LEFT=1
while (( $(now_ms) - T2 <= EXIT_TIMEOUT * 1000 )); do
  if ! alive; then LEFT=0; break; fi
  sleep 0.2
done
DOWN_MS=$(( $(now_ms) - T2 ))

# Every failure exits with context: echoing only the matching lines throws the scene away
if [ -n "$ERRS" ]; then
  echo "SMOKE_FAIL main-process errors:"; echo "$ERRS"
  KEEP="/tmp/$APP-smoke-fail-$(date +%Y%m%d-%H%M%S).log"
  cp "$LOG" "$KEEP" 2>/dev/null && echo "full log saved: $KEEP"
  echo "--- last 25 lines of $LOG ---"; tail -25 "$LOG"
  cleanup
  exit 1
fi
if [ "$LEFT" != "0" ]; then
  echo "SMOKE_FAIL: orphan protection did not work (electron did not exit on its own within ${EXIT_TIMEOUT}s)"
  echo "--- processes still alive in this group ---"; pgrep -g "$DEVPID" -fl "$PAT"
  KEEP="/tmp/$APP-smoke-fail-$(date +%Y%m%d-%H%M%S).log"
  cp "$LOG" "$KEEP" 2>/dev/null && echo "full log saved: $KEEP"
  echo "--- last 25 lines of $LOG ---"; tail -25 "$LOG"
  cleanup
  exit 1
fi
cleanup
echo "SMOKE_OK: startup ${UP_MS}ms · ready ${READY_MS}ms · self-exit after parent kill ${DOWN_MS}ms; no errors, no orphans"
