#!/bin/bash
# dev 冒烟模板:启动 → 等就绪产物出现 → 抓主进程错误 → 杀父进程验孤儿防护。
# 正本在 electron-scaffold skill;复制为项目 scripts/smoke.sh 后,填好下方
# 「项目填空」块即可。设计依据与验证方法见 electron-scaffold skill 的 electron-testing.md 第 3 节
# ——**装完把每条失败分支强制触发一遍**,没验证过会红的门禁等于没有门禁。
#
# **与已开着的实例共存**(agentshed 实测回填,2026-08-04):
#   - userData 隔离:dev app 经 `pnpm dev -- --user-data-dir=<临时目录>` 启动(实测
#     electron-vite 透传该参且 Electron 认它——e2e 同机制,真实归档零污染已核实)。
#     single-instance lock 按 userData 界定作用域,隔离后与用户开着的 app 互不抢锁
#     ——此前锁被占时本脚本起的 app 会 app.exit(0) 静默假死,三次误红的根因。
#   - 进程组隔离:set -m 让后台任务自成进程组,所有探测/击杀只认自己这棵树
#     (pgrep/kill 按 pgid),永不误伤用户的实例。
#   - app 读的业务数据不受影响(那是 HOME/数据根的事,与 userData 无关);每次全新
#     userData = 每次都是确定性的首启路径——门禁要确定性,不要残留状态的快。
#     「旧数据迁移」场景归 e2e(预置 fixture),本就不该指望冒烟撞上。
#
# 一律轮询到条件成立,不用固定 sleep(2026-08-03 改):
#   误红比慢更贵:门禁抖过几次,"重跑一下就好"就成了习惯,它也就不再是门禁。
# 超时按实测量级留足余量,并把实际耗时打出来——将来变慢看得见,不会悄悄逼近超时。
set -u
set -m   # 后台任务自成进程组:$! 即 pgid,探测与击杀都以此为界
cd "$(dirname "$0")/.."

# ══════════════ 项目填空(其余照抄)══════════════
APP=myapp                                    # 项目短名:日志与临时目录命名
QUIET_ENV=MYAPP_NO_FOREGROUND                # 主进程测试静音 seam 的 env 名(electron-scaffold 的 electron-testing.md 第 1 节)
# ① 就绪产物:app 每次启动必然**原子写**的文件,相对 userData 的路径。
#    判据:它出现 = 主进程完整跑通了一轮核心路径;没有这种文件就先给 app 加一个。
READY_ARTIFACT="your-ready-artifact.json"        # 例:agentshed 用的是 token-cache.json
# ② 本项目 dev Electron 的进程匹配(含仓库路径,避免匹配到别的 Electron 项目;按 ERE 解释,路径含 + . 等元字符时注意转义)
PAT="path/to/your-repo/node_modules.*Electron.app/Contents/MacOS/Electron"
PACKAGED_PAT="MyApp.app/Contents/MacOS/MyApp" # 打包版二进制(仅共存提示用)
# ③ 真实 userData(仅作"重定向失效"自诊断的只读对照,本脚本绝不写它)
REAL_UD="$HOME/Library/Application Support/myapp"
# 主进程错误特征;项目自有的致命标记(如契约校验失败)往后追加
ERR_PATTERN="Error occurred in handler|UnhandledPromiseRejection|TypeError|uncaught"
# ═══════════════════════════════════════════════

# 未填空守卫:占位值直接失败,别让人对着 60s 超时猜
case "$PAT$READY_ARTIFACT" in
  *your-repo* | *your-ready-artifact*)
    echo "SMOKE_FAIL: 模板未填空——先填顶部「项目填空」块(PAT / READY_ARTIFACT 仍是占位值)"; exit 1 ;;
esac

LOG=/tmp/$APP-smoke.log
SMOKE_UD=$(mktemp -d "/tmp/$APP-smoke-ud.XXXXXX")
CACHE="$SMOKE_UD/$READY_ARTIFACT"
REAL_CACHE="$REAL_UD/$READY_ARTIFACT"

# 超时规范:先实测一次量级,给十倍余量,并在成功输出里打印实际耗时——
# 将来变慢看得见,不会悄悄逼近超时。历史教训(agentshed):超时三次误红,
# 真因不是慢是**死**(锁被占静默退出);双隔离后走到超时的才是真超时。
START_TIMEOUT=60   # 【按实测调】electron 出进程,agentshed 实测 ~1.1s
READY_TIMEOUT=60   # 【按实测调】就绪产物出现,agentshed 全量首扫实测 ~6s
EXIT_TIMEOUT=15    # 【按实测调】杀父后自退:主进程按 1s 轮询父存活 + 退出开销

now_ms() { echo $(( $(date +%s%N) / 1000000 )); }
DEVPID=""
alive() { [ -n "$DEVPID" ] && pgrep -g "$DEVPID" -f "$PAT" >/dev/null 2>&1; }
cleanup() {
  [ -n "$DEVPID" ] && kill -9 -- "-$DEVPID" 2>/dev/null
  rm -rf "$SMOKE_UD"
}
die() {
  echo "SMOKE_FAIL: $1"
  # 现场必须留档:不赌调用方不 grep——agentshed 三轮误诊全因失败输出被过滤、无证可查
  KEEP="/tmp/$APP-smoke-fail-$(date +%Y%m%d-%H%M%S).log"
  cp "$LOG" "$KEEP" 2>/dev/null && echo "完整日志已存:$KEEP"
  tail -25 "$LOG"
  cleanup
  exit 1
}

# 已有实例只提示不拦截——隔离后共存是特性。按 comm 过滤,pgrep -f 会被
# 别人 argv 里的路径字符串误报(如某个 pkill 命令行),路径匹配不等于进程本体。
OTHERS=$(pgrep -f "$PAT|$PACKAGED_PAT" 2>/dev/null | while read -r p; do
  case "$(ps -o comm= -p "$p" 2>/dev/null)" in
    *Electron | *"${PACKAGED_PAT##*/}") echo "$p" ;;
  esac
done | tr '\n' ' ')
[ -n "$OTHERS" ] && echo "(检测到已有实例 pid=$OTHERS —— userData 已隔离,互不影响,不会误杀)"

REAL_BEFORE=$(stat -f %m "$REAL_CACHE" 2>/dev/null || echo 0)

# 测试静音两件套(electron-scaffold 的 electron-testing.md 第 1/2 节 + scripts/quiet-electron.sh):
#   $QUIET_ENV —— 窗口不显示,不抢前台焦点;
#   ELECTRON_OVERRIDE_DIST_PATH —— 用 LSUIElement=true 的副本,Dock 图标连闪现都没有
#   (图标在原生引导期就按 plist 注册,JS 的 dock.hide() 追不上)。
bash scripts/quiet-electron.sh
export ELECTRON_OVERRIDE_DIST_PATH="$PWD/node_modules/.cache/electron-quiet/dist"
# electron-vite **不经过** electron/index.js(自读 path.txt 拼路径,实测 lib 源码),
# 上面那个变量对它无效;它认的是自家的 ELECTRON_EXEC_PATH,两个都给
export ELECTRON_EXEC_PATH="$PWD/node_modules/.cache/electron-quiet/dist/Electron.app/Contents/MacOS/Electron"
env "$QUIET_ENV=1" pnpm dev -- --user-data-dir="$SMOKE_UD" > "$LOG" 2>&1 &
DEVPID=$!
T0=$(now_ms)
until alive; do
  (( $(now_ms) - T0 > START_TIMEOUT * 1000 )) && die "${START_TIMEOUT}s 内 electron 未启动(本组内)"
  sleep 0.2
done
UP_MS=$(( $(now_ms) - T0 ))

# 就绪判据取「核心路径跑通」:app 启动后必然原子写就绪产物(隔离目录内,全新
# 目录首启必写),文件出现即核心路径真跑通;静默失败则超时报红。
T1=$(now_ms)
until [ "$(stat -f %m "$CACHE" 2>/dev/null || echo 0)" -gt 0 ]; do
  if ! alive; then
    die "electron 启动后又退出了(主进程崩溃?看下方日志)"
  fi
  if (( $(now_ms) - T1 > READY_TIMEOUT * 1000 )); then
    # 判别诊断:隔离侧没动而真实 userData 动了 = --user-data-dir 透传失效
    # (electron-vite 升级弃透传之类),app 跑去写真实 userData 了
    REAL_NOW=$(stat -f %m "$REAL_CACHE" 2>/dev/null || echo 0)
    if [ "$REAL_NOW" -gt "$REAL_BEFORE" ]; then
      die "userData 重定向失效:隔离侧未更新,真实 userData 却更新了——检查 pnpm dev 的 --user-data-dir 透传"
    fi
    die "${READY_TIMEOUT}s 内就绪产物未出现($READY_ARTIFACT)"
  fi
  sleep 0.3
done
READY_MS=$(( $(now_ms) - T1 ))

ERRS=$(grep -iE "$ERR_PATTERN" "$LOG" | head -5)

EPID=$(pgrep -g "$DEVPID" -f "$PAT" | head -1)
# 竞态守卫:app 可能写完就绪产物后立刻崩——EPID 取不到时,杀父与孤儿检查整段
# 空转,若日志又没有错误行就是假绿。就绪后进程必须还活着,不在即失败。
[ -z "$EPID" ] && die "就绪产物已写出,但 electron 进程已消失(写完即崩?)"
PARENT=$(ps -o ppid= -p "$EPID" | tr -d ' ')
T2=$(now_ms)
kill -9 "$PARENT" 2>/dev/null
LEFT=1
while (( $(now_ms) - T2 <= EXIT_TIMEOUT * 1000 )); do
  if ! alive; then LEFT=0; break; fi
  sleep 0.2
done
DOWN_MS=$(( $(now_ms) - T2 ))

# 失败一律带上下文再退:只 echo 命中的那几行,等于把现场丢了
if [ -n "$ERRS" ]; then
  echo "SMOKE_FAIL 主进程有错误:"; echo "$ERRS"
  KEEP="/tmp/$APP-smoke-fail-$(date +%Y%m%d-%H%M%S).log"
  cp "$LOG" "$KEEP" 2>/dev/null && echo "完整日志已存:$KEEP"
  echo "--- $LOG 末 25 行 ---"; tail -25 "$LOG"
  cleanup
  exit 1
fi
if [ "$LEFT" != "0" ]; then
  echo "SMOKE_FAIL: 孤儿防护未生效(${EXIT_TIMEOUT}s 内 electron 未自退)"
  echo "--- 本组仍在的进程 ---"; pgrep -g "$DEVPID" -fl "$PAT"
  KEEP="/tmp/$APP-smoke-fail-$(date +%Y%m%d-%H%M%S).log"
  cp "$LOG" "$KEEP" 2>/dev/null && echo "完整日志已存:$KEEP"
  echo "--- $LOG 末 25 行 ---"; tail -25 "$LOG"
  cleanup
  exit 1
fi
cleanup
echo "SMOKE_OK: 启动 ${UP_MS}ms · 就绪 ${READY_MS}ms · 杀父后自退 ${DOWN_MS}ms;无错误、无孤儿"
